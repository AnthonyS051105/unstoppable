# Database — Supabase Postgres (PostGIS + pgRouting aktif di dashboard).
# Pakai connection string Postgres (BUKAN URL https Supabase).
# sslmode=require (AD-08). uselibpqcompat=true: kompatibilitas TLS Supabase
# pooler dengan driver node-postgres v8+ (menghindari error "self-signed
# certificate in certificate chain" tanpa menonaktifkan enkripsi).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true"

# Auth (modul auth — Anthon)
JWT_SECRET="ganti-dengan-secret-acak-di-.env-lokal"
# SMS_PROVIDER_API_KEY belum diisi -> OTP ditulis ke log server (mode dev), lihat SDD §12.1.
# SMS_PROVIDER_API_KEY=

# Supabase Storage (foto laporan — reports.storage.ts)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service-role-key"

# Speech microservice (voice-microservices/, Python/FastAPI — Piper TTS + Whisper STT)
# Tidak diekspos publik; hanya backend ini yang boleh memanggilnya (SDD §11).
SPEECH_SERVICE_URL="http://localhost:8080"
SPEECH_SERVICE_API_KEY="samakan-dengan-INTERNAL_API_KEY-di-voice-microservices/.env"

# AI Planner (modul ai-planner — @google/genai). API key dari Google AI Studio.
GEMINI_API_KEY=""
