DATABASE_URL="postgresql://unstoppable:unstoppable@localhost:5433/unstoppable?schema=public"
REDIS_URL="redis://localhost:6379"

# Auth (modul auth — Anthon)
JWT_SECRET="ganti-dengan-secret-acak-di-.env-lokal"
# SMS_PROVIDER_API_KEY belum diisi -> OTP ditulis ke log server (mode dev), lihat SDD §12.1.
# SMS_PROVIDER_API_KEY=

# Supabase Storage
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service-role-key"

# Speech microservice (voice-microservices/, Python/FastAPI — Piper TTS + Whisper STT)
# Tidak diekspos publik; hanya backend ini yang boleh memanggilnya (SDD §11).
SPEECH_SERVICE_URL="http://localhost:8080"
SPEECH_SERVICE_API_KEY="samakan-dengan-INTERNAL_API_KEY-di-voice-microservices/.env"