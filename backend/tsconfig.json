{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    // TypeScript 7 mewajibkan rootDir eksplisit (TS5011). rootDir="." karena
    // Prisma client di ./generated ikut terkompilasi sebagai dependensi impor
    // (rootDir=./src memicu TS6059). Akibatnya entry point ada di
    // dist/src/index.js; script "start" disesuaikan.
    "rootDir": ".",
    "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    "target": "esnext",
    "types": [],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  },
  // Build aplikasi: hanya kode di src/. Seed/skrip/smoke dijalankan via tsx,
  // bukan bagian dari output dist. Test & smoke dikecualikan dari tsc build.
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "generated",
    "**/*.test.ts",
    "**/*.smoke.ts",
    "**/*.smoke.test.ts",
    "src/tests/**",
    "scripts/**"
  ]
}
