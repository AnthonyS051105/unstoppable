{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    // rootDir sengaja TIDAK di-set eksplisit: Prisma client di-generate ke
    // ../generated/prisma (di luar src) dan hanya DI-IMPORT, bukan dikompilasi.
    // Menyetel rootDir=./src memicu TS6059 untuk file itu. outDir tetap ./dist
    // supaya "npm start" (node dist/index.js) bekerja. Scope kompilasi dibatasi
    // lewat "include"/"exclude" di bawah.
    "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    "target": "esnext",
    "types": [],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  },
  // Build aplikasi: hanya kode di src/. Seed/skrip/smoke dijalankan via tsx,
  // bukan bagian dari output dist. Test & smoke dikecualikan dari tsc build.
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "generated",
    "**/*.test.ts",
    "**/*.smoke.ts",
    "**/*.smoke.test.ts",
    "src/tests/**",
    "scripts/**"
  ]
}
