# Salin ke /opt/unstoppable/.env di VM (chmod 600). Variabel untuk compose itu sendiri.
API_DOMAIN=sub.duckdns.org
# Tahap A (image dikirim langsung via docker load):
BACKEND_IMAGE=unstoppable-backend
BACKEND_TAG=manual-1
# Tahap B (CI): BACKEND_IMAGE=<REGION>-docker.pkg.dev/<PROJECT_ID>/unstoppable/backend ; BACKEND_TAG ditimpa CI

# Voice (opsional):
# COMPOSE_PROFILES=voice
# VOICE_IMAGE=unstoppable-voice
# VOICE_TAG=1
