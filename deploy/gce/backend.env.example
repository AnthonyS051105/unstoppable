# Salin ke /opt/unstoppable/backend.env di VM (chmod 600). Acuan: backend/.env.example
# Aturan env_file compose: TANPA tanda kutip; "$" ditulis "$$".
DATABASE_URL=postgresql://postgres.<ref>:<password-url-encoded>@<region>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true
JWT_SECRET=<openssl rand -base64 48>
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SPEECH_SERVICE_API_KEY=<sama dengan INTERNAL_API_KEY di voice.env>
GEMINI_API_KEY=<key>
GEOCODER_URL=https://photon.komoot.io
VAPID_PUBLIC_KEY=<npx web-push generate-vapid-keys>
VAPID_PRIVATE_KEY=<...>
VAPID_SUBJECT=mailto:<email-tim>
# Persis origin FE: https, tanpa "/" di akhir, satu nilai.
FRONTEND_URL=https://<project>.vercel.app
