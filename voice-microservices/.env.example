# Salin file ini menjadi .env lalu isi INTERNAL_API_KEY dengan string acak.
# Generate: openssl rand -base64 32

# Kunci yang WAJIB dikirim backend Express di header X-Internal-Key.
INTERNAL_API_KEY=ganti-dengan-string-acak

# Whisper: tiny | base | small  — JANGAN large (CPU-only tidak kuat)
WHISPER_MODEL_SIZE=base
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=id

# Batas ukuran upload audio ke /transcribe (bytes). Default 10 MB.
MAX_AUDIO_BYTES=10485760
