# Copy to .env.local (never commit .env.local).
# Base URL of the backend REST API, including the /api prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
# Origin of the Socket.io server (same server as the API, without /api).
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# Address search still calls Photon directly until F4 (backend /geocode proxy) lands.
NEXT_PUBLIC_GEOCODER_URL=https://photon.komoot.io
